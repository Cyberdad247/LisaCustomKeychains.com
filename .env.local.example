# ─── AI Provider (pick ONE or more — first configured wins) ──────────────────
#
# Option A: Ollama (local, completely free — best for dev)
# Run: pwsh scripts/setup-ollama.ps1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
#
# Option B: Google Gemini (free tier — works on Vercel production)
# Get key at: https://aistudio.google.com/app/apikey
# Free: 15 requests/min · 1,000,000 tokens/day
# GOOGLE_AI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-1.5-flash
#
# Option C: Anthropic Claude (paid — highest quality)
# ANTHROPIC_API_KEY=sk-ant-...
#
# Override auto-detection: force a specific provider
# AI_PROVIDER=ollama
# AI_PROVIDER=gemini
# AI_PROVIDER=anthropic

# ─── Shopify ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=jgvme0-av.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_token_here

# ─── Auth ─────────────────────────────────────────────────────────────────────
OWNER_DASHBOARD_PASSWORD=your_password_here

# ─── Social Feed (optional) ───────────────────────────────────────────────────
# META_ACCESS_TOKEN=your_meta_token

# ─── Calendar Sync (optional) ─────────────────────────────────────────────────
# GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/...
# CRON_SECRET=your_cron_secret
# NEXT_PUBLIC_GOOGLE_CALENDAR_SUBSCRIBE_URL=webcal://...
