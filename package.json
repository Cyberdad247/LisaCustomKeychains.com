{
  "name": "lisa-custom-keychains",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "camelot": "node scripts/camelot.js",
    "shopify:cli:auth": "shopify store auth --store jgvme0-av.myshopify.com --scopes read_products,write_products,read_product_listings,write_product_listings",
    "shopify:cli:probe": "shopify store execute --store jgvme0-av.myshopify.com --query \"query { shop { name myshopifyDomain primaryDomain { url } } }\" --json",
    "shopify:sync": "node scripts/camelot.js sync all",
    "shopify:app:dev": "cd ../lisa-shopify-app && npm run dev",
    "shopify:app:build": "cd ../lisa-shopify-app && npm run build",
    "shopify:app:deploy": "cd ../lisa-shopify-app && npm run deploy",
    "shopify:app:setup": "cd ../lisa-shopify-app && npm run setup",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@shopify/shopify-api": "^12.3.0",
    "@supabase/supabase-js": "^2.89.0",
    "autoprefixer": "^10.4.23",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "form-data": "^4.0.5",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.469.0",
    "next": "^16.2.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.27",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
