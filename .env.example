NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=jgvme0-av.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_DOMAIN=jgvme0-av.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_or_storefront_token_here

# Optional. Required only for Admin API scripts that create, update, publish, or audit products.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_admin_token_here

# Optional. Server-only Shopify app credentials for future OAuth/Admin tooling.
SHOPIFY_API_KEY=shopify_app_api_key_here
SHOPIFY_API_SECRET=shopify_app_api_secret_here

# Required to use /client-editor. Keep both values server-only.
OWNER_DASHBOARD_PASSWORD=replace_with_a_strong_client_editor_password
OWNER_DASHBOARD_SECRET=replace_with_a_long_random_session_secret

# Storefront config + image persistence.
# On Vercel the serverless filesystem is read-only/ephemeral, so /client-editor
# edits and uploads must be stored in Supabase. With these set, config saves to
# the `storefront_config` table and images upload to the `storefront-uploads`
# Storage bucket. Without them, the app falls back to the local filesystem
# (fine for local dev only). See docs/STOREFRONT_CONFIG_PERSISTENCE.md for setup.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Preferred for owner-editor writes so they bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional overrides for the table/bucket names.
# STOREFRONT_CONFIG_TABLE=storefront_config
# STOREFRONT_UPLOAD_BUCKET=storefront-uploads

# AI provider for the conversational editor + Hermes copy assist.
# Auto-precedence (free/local first): Ollama -> Gemini -> Anthropic.
# Set at least one. Override precedence with AI_PROVIDER=ollama|gemini|anthropic.
# OLLAMA_BASE_URL=http://localhost:11434      # free, local
# OLLAMA_MODEL=llama3.2
# GOOGLE_AI_API_KEY=your_gemini_api_key        # free tier
# GEMINI_MODEL=gemini-1.5-flash
# ANTHROPIC_API_KEY=your_anthropic_api_key     # paid
# ANTHROPIC_MODEL=claude-sonnet-4-6            # config-agent override (e.g. claude-opus-4-8)
