# Copy this file to scripts/setup/.env.setup and fill in the values, then run:
#   bash scripts/setup/configure.sh
#
# .env.setup is gitignored — never commit real secrets.
# Generate a strong session secret with:  openssl rand -hex 32

# ── Owner dashboard (REQUIRED) ────────────────────────────────────────────────
# Without these the owner editor fails closed (no login) — see PR #4.
OWNER_DASHBOARD_PASSWORD=
OWNER_DASHBOARD_SECRET=

# ── Supabase persistence (REQUIRED for durable edits on Vercel) ───────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres URI used ONLY to apply the SQL (Supabase: Settings → Database →
# Connection string → URI). Not pushed to Vercel. Leave blank to apply the SQL
# manually in the Supabase SQL editor instead.
SUPABASE_DB_URL=

# ── AI provider for the conversational editor (set AT LEAST ONE) ──────────────
# Precedence if multiple: Ollama → Gemini → Anthropic. Override with AI_PROVIDER.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
GOOGLE_AI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=
# OLLAMA_MODEL=llama3.2
# AI_PROVIDER=anthropic
